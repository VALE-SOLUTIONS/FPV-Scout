# RockBase NM-CYD-C5 (ESP32-C5-WROOM-1-N16R8): ESPsoup with the touch-screen UI.
# Build: idf.py -B build-cyd-c5 -DIDF_TARGET=esp32c5 -DSDKCONFIG=build-cyd-c5/sdkconfig
#        "-DSDKCONFIG_DEFAULTS=sdkconfig.defaults;sdkconfig.defaults.esp32c5;sdkconfig.defaults.cyd-c5" build
CONFIG_ESPSOUP_CYD_UI=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Keep the Bluetooth host and wallpaper buffers in the board's PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_BT_NIMBLE_ROLE_PERIPHERAL is not set
# CONFIG_BT_NIMBLE_ROLE_BROADCASTER is not set
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# CONFIG_BT_NIMBLE_SECURITY_ENABLE is not set
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_EXT_ADV=y
CONFIG_BT_NIMBLE_EXT_SCAN=y
# CONFIG_BT_NIMBLE_ENABLE_PERIODIC_ADV is not set
# CONFIG_BT_NIMBLE_ENABLE_PERIODIC_SYNC is not set
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
# Static IRAM/DRAM must end below the RF dump bank at 0x40820000 (sram_guard.ld):
# keep the SPI driver out of IRAM; the UI only uses polled transfers.
# CONFIG_SPI_MASTER_IN_IRAM is not set
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set

# Single factory app: boots directly to FPV Scout.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-cyd-c5.csv"
